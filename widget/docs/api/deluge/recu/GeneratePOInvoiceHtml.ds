void GeneratePOInvoiceHtml(int orderid)
{
	order = Purchase_Order[ID == orderid];
	billingVendor = Address[BILLING_Vendor == order.Vendor && Primary];
	if(order.count() > 0)
	{
		vendor = Vendor[ID == order.Vendor];
		order.INVOICE_HTML=" <style>" + "       .address," + "       .address * {" + "         font-size: 12px;" + "         padding: 0!important;" + "         margin: 5px 0!important;" + "       }" + "       a {" + "         text-decoration: none!important;" + "       }" + "       .wrapper {" + "         position: relative;" + "         display: inline-block;" + "         background: #bbb;" + "         height: 120px;" + "         text-align: center;" + "         display: flex;" + "         flex-direction: column;" + "         flex-wrap: wrap;" + "         align-content: center;" + "         justify-content: center;" + "         align-items: center;" + "       }" + "       p{margin:0}" + "       span.zcc-title {" + "         font-size: 1.1rem;" + "         color: white;" + "         writing-mode: vertical-rl;" + "         text-orientation: mixed;" + "         transform: scale(-1);" + "         font-weight: 800;" + "       }" + "       .zcc-content>span {" + "         display: block;" + "         width: 100%;" + "         padding: 3px;" + " margin:0;" + "       }" + " .zcc-container{" + "  border:1px solid #000;" + " }" + " table.blueTable {" + "   border: 1px solid #000;" + "   background-color: #fff;" + "   width: 100%;" + "   text-align: left;" + "   border-collapse: collapse;" + " }" + " table.blueTable td, table.blueTable th {" + "   padding: 3px 2px;" + " }" + " table.blueTable tbody td {" + "   font-size: 13px;vertical-align: text-top;" + " }" + " table.blueTable thead {" + "   background: #000000;" + "   border-bottom: 2px solid #000;" + " }" + " table.blueTable thead th {" + "   font-size: 15px;" + "   font-weight: normal;" + "   color: #FFFFFF;" + "   text-align: center;" + "   border-left: 2px solid #000;" + " }" + " table.blueTable td{" + " text-align:center" + " }" + " table.blueTable td" + " table.blueTable thead th:nth-child(2) {" + "   border-left: none;" + "  text-align:left;" + " }" + "     </style>" + " <div class='zcc-container'>" + " <div  style='display:flex;padding:5px 10px;" + " '>" + "   <div style='display: flex;flex-basis: 50%;'>" + "     <p class='wrapper'>" + "       <span class='zcc-title'>Supplier\n" + "</span>" + "     </p>" + "     <p class='zcc-content'>" + "       <span>" + order.Vendor.Vendor_Name + "         </span>" + "       <span>" + billingVendor.Address.address_line_1 + " </span>" + "       <span>" + ifnull(billingVendor.Address.address_line_2,'') + " </span>" + "       <span>" + billingVendor.Address.district_city + " , " + billingVendor.Address.state_province + " </span>" + "       <span>" + billingVendor.Address.country + " </span>" + "       <span>" + "         Tel: " + Contacts[Vendor == order.Vendor && Primary == true].Work_Phone + "       </span>" + "     </p>" + "   </div>" + "   <div style='display:flex;flex-basis: 50%;'>" + "     <p class='wrapper' style='" + "     text-align: center;" + "     display: flex;" + "     flex-direction: column;" + "     flex-wrap: wrap;" + "     align-content: center;" + "     justify-content: center;" + "     align-items: center;" + " '>" + "       <span class='zcc-title'>Ship to\n" + "</span>" + "     </p>" + "     <p class='zcc-content'>" + "       <span>" + " Cogiscan\n" + " </span>" + "       <span>" + " " + ifnull(order.Previous_address.Ship_to.address_line_1,"") + "\n" + " </span>" + "\n" + "       <span>" + "" + ifnull(order.Previous_address.Ship_to.address_line_2,"") + ", " + ifnull(order.Previous_address.Ship_to.district_city,"") + "\n" + " </span>" + "       <span>" + "" + ifnull(order.Previous_address.Ship_to.country,"") + ", " + ifnull(order.Previous_address.Ship_to.postal_Code,"") + "\n" + " </span>" + "       <span>" + "         Tel: +1 (450)-534-2644\n" + "       </span>" + "     </p>" + " </div>" + " </div><div style='display:flex;align-items: flex-start;'>" + " <table style='margin: 0px auto; width: 50%;border-top:1px solid #000'" + "     cellspacing='0' cellpadding='1px'>" + "     <tbody>" + "       <tr>" + "         <td  style='padding:5px;width:40%'>" + "          Cogiscan Contact" + "         </td>" + "         <td  style='padding:5px'>" + ifnull(order.Cogiscan_Contact,"") + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Vendor Contact" + "         </td>" + "         <td  style='padding:5px'>" + ifnull(order.Vendor_contact.First_Name,"") + " " + ifnull(order.Vendor_contact.Last_Name,"") + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Currency" + "         </td>" + "         <td  style='padding:5px'>" + ifnull(vendor.Currency1.Code,"") + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Expected delivery date" + "         </td>" + "         <td  style='padding:5px'>" + ifnull(order.Required_Date_ISO,"") + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Delivery method" + "         </td>" + "         <td  style='padding:5px'>" + "          " + "         </td>" + "       </tr>" + "     </tbody>" + "   </table>" + " <table style='margin: 0px auto; width: 50%;border-top:1px solid #000'" + "     cellspacing='0' cellpadding='1px'>" + "     <tbody>" + "  <tr>" + "         <td  style='padding:5px;width:40%'>" + "          Carrier" + "         </td>" + "         <td  style='padding:5px'>" + order.Carrier + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Incoterms" + "         </td>" + "         <td  style='padding:5px'>" + "          " + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Payment terms" + "         </td>" + "         <td  style='padding:5px'>" + "          " + ifnull(order.Payment_Term.Label,vendor.Payment_Term.Label) + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "          Tax code" + "         </td>" + "         <td  style='padding:5px'>" + "         </td>" + "       </tr>" + "  <tr>" + "         <td  style='padding:5px'>" + "" + "         </td>" + "         <td  style='padding:5px'>" + "          " + "         </td>" + "       </tr>" + "     </tbody>" + "   </table>" + " </div></div>" + " <table class='blueTable'>" + " <thead>" + " <tr>" + " <th>P/N - Description.</th>" + " <th>Alias</th>" + " <th>Qty Ord.</th>" + " <th>UoM</th>" + " <th>Required</th>" + " <th>Unit Price</th>" + "<th>Total</th>" + " </tr>" + " </thead>" + " <tbody>";
		for each  itemIndex in SF_Products_PO[Purchase_Order == orderid]
		{
			order.INVOICE_HTML=order.INVOICE_HTML + "<tr><td style='text-align:left'>" + "<h4 style='margin:0;font-size:13px'>" + itemIndex.P_N_SKU.SKU + "</h4>" + "<p style='color:#444;font-size:11px;'>" + itemIndex.Description + "</p>" + "</td>" + "<td>" + ifnull(SF_Vendors[Vendor == order.Vendor && Product == itemIndex.P_N_SKU].Product_Vendor,"") + "</td>" + "<td>" + itemIndex.Qty + "</td>" + "<td>" + ifnull(itemIndex.P_N_SKU.Weight_unit,"") + "</td>" + "<td>" + itemIndex.Expected_receipt_date + "</td>" + "<td>" + thisapp.Tools.ConvertIntegerToCurrency(itemIndex.Unit_price) + "</td>" + "<td>" + thisapp.Tools.ConvertIntegerToCurrency(itemIndex.Total_Price) + "</td></tr>";
		}
		order.INVOICE_HTML=(order.INVOICE_HTML + "</tbody>" + "</table>").replaceAll(" null ","");
	}
}